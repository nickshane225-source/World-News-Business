PORT=5000
SITE_URL=https://worldnews.business

# Supabase (Service Role Key bypasses RLS on the backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (BullMQ job queue)
REDIS_URL=redis://127.0.0.1:6379

# Admin Auth
ADMIN_EMAIL=admin@worldnews.business
ADMIN_PASSWORD_HASH=
# Temporary legacy fallback; set false after configuring ADMIN_PASSWORD_HASH
ALLOW_LEGACY_ADMIN_PASSWORD=true
# Temporary only; remove after migration
ADMIN_PASSWORD=
JWT_SECRET=change-this-32-char-random-secret
CORS_ALLOWED_ORIGINS=https://worldnews.business,https://www.worldnews.business

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
